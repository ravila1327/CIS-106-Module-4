    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="firstName" type="String" array="False" size=""/>
            <declare name="steps" type="Integer" array="False" size=""/>
            <declare name="calories" type="Real" array="False" size=""/>
            <output expression="&quot;enter first name&quot;" newline="True"/>
