    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="mealTotal" type="Real" array="False" size=""/>
            <declare name="tip" type="Real" array="False" size=""/>
            <output expression="&quot;enter meal total&quot;" newline="True"/>
            <input variable="mealTotal"/>
            <assign variable="tip" expression="mealTotal * 0.15"/>
            <output expression="&quot;with 15% Tip&quot;" newline="True"/>
            <output expression="mealtotal" newline="True"/>
            <output expression="tip" newline="True"/>
            <output expression="mealTotal + tip" newline="True"/>
            <assign variable="tip" expression="mealTotal * 0.18"/>
            <output expression="&quot;With 18% tip&quot;" newline="True"/>
            <output expression="mealTotal" newline="True"/>
            <output expression="tip" newline="True"/>
            <output expression="mealTotal + tip" newline="True"/>
            <assign variable="tip" expression="mealTotal * 0.20"/>
            <output expression="&quot;with 20% Tip&quot;" newline="True"/>
            <output expression="mealTotal" newline="True"/>
            <output expression="tip" newline="True"/>
            <output expression="mealTotal + tip" newline="True"/>
        </body>
    </function>
</flowgorithm>
