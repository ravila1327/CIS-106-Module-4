    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="PurchasePrice" type="Real" array="False" size=""/>
            <declare name="CurrentPrice" type="Real" array="False" size=""/>
            <declare name="Quantity" type="Integer" array="False" size=""/>
            <declare name="Value" type="Real" array="False" size=""/>
            <output expression="&quot;enter purchase price&quot;" newline="True"/>
            <input variable="PurchasePrice"/>
            <output expression="&quot;enter current stock price&quot;" newline="True"/>
            <input variable="CurrentPrice"/>
            <output expression="&quot;enter quantity&quot;" newline="True"/>
            <input variable="Quantity"/>
            <assign variable="Value" expression="(CurrentPrice - PurchasePrice) * Quantity"/>
            <output expression="Value" newline="True"/>
        </body>
    </function>
</flowgorithm>
